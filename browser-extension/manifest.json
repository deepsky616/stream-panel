{
  "manifest_version": 3,
  "name": "스트림 패널 웹 업무 도우미",
  "description": "스트림 패널에서 나이스와 에듀파인의 정해진 업무 화면을 엽니다.",
  "version": "1.0.0",
  "minimum_chrome_version": "100",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:38473/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "스트림 패널 웹 업무 도우미",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:38473/setup*"],
      "js": ["setup.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://goe.neis.go.kr/*",
        "https://klef.goe.go.kr/*"
      ],
      "js": ["workflow-engine.js", "content.js"],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_idle"
    }
  ]
}
